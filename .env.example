# ===================================================================
# Configuración de tut_bot - Tutor Fonético Inteligente
# ===================================================================

# Azure Cognitive Services Speech (Free Tier F0: 5 horas gratis/mes)
# Obtén tu clave y región en https://portal.azure.com (Crear recurso 'Speech services' en plan Free F0)
AZURE_SPEECH_KEY=tu_azure_speech_key_aqui
AZURE_SPEECH_REGION=eastus

# Google Gemini API (Free Tier en Google AI Studio)
# Obtén tu clave gratis en https://aistudio.google.com ("Get API key")
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Puerto y Host del servidor local
PORT=8000
HOST=0.0.0.0

# Modo Simulación: Si está en True o las claves no son válidas, genera evaluaciones simuladas realistas
# para pruebas de interfaz sin consumir cuota o sin requerir claves de inmediato.
MOCK_MODE=false
